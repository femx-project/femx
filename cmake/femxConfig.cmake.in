@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

if(@FEMX_HAS_CUDA@)
  find_dependency(CUDAToolkit)
endif()

if(@FEMX_ENABLE_OPENMP@)
  find_package(OpenMP QUIET COMPONENTS CXX)
  if(NOT TARGET OpenMP::OpenMP_CXX)
    include("${CMAKE_CURRENT_LIST_DIR}/FemxClangOpenMP.cmake")
    femx_find_clang_openmp()
  endif()
  if(NOT TARGET OpenMP::OpenMP_CXX)
    set(femx_FOUND FALSE)
    set(femx_NOT_FOUND_MESSAGE
        "femx requires OpenMP, but the C++ OpenMP runtime was not found.")
    return()
  endif()
endif()

if(@FEMX_HAS_RESOLVE@)
  if(@FEMX_HAS_ENZYME@ AND @FEMX_HAS_CUDA@)
    find_path(
      ReSolve_DIR
      NAMES ReSolveTargets.cmake
      HINTS "${ReSolve_ROOT}" "$ENV{ReSolve_ROOT}"
      PATH_SUFFIXES share/resolve/cmake lib/cmake/ReSolve)
    if(NOT EXISTS "${ReSolve_DIR}/ReSolveTargets.cmake")
      set(femx_FOUND FALSE)
      set(femx_NOT_FOUND_MESSAGE
          "femx requires a ReSolve develop package. Set ReSolve_DIR or "
          "add its installation prefix to CMAKE_PREFIX_PATH.")
      return()
    endif()
    include("${ReSolve_DIR}/ReSolveTargets.cmake")
    set(ReSolve_FOUND TRUE)
  else()
    find_dependency(ReSolve CONFIG)
  endif()
endif()

if(@FEMX_HAS_HDF5@)
  find_dependency(HDF5 COMPONENTS C)
endif()

if(@FEMX_HDF5_USES_MPI@)
  find_dependency(MPI COMPONENTS CXX)
endif()

if(@FEMX_HAS_PETSC@)
  find_dependency(MPI COMPONENTS CXX)
  find_dependency(PkgConfig)
  if(NOT TARGET PkgConfig::PETSC)
    pkg_check_modules(PETSC QUIET IMPORTED_TARGET PETSc)
    if(NOT PETSC_FOUND)
      pkg_check_modules(PETSC REQUIRED IMPORTED_TARGET petsc)
    endif()
  endif()
endif()

if(@FEMX_HAS_ENZYME@)
  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    set(femx_FOUND FALSE)
    set(femx_NOT_FOUND_MESSAGE
        "This femx package was built with Enzyme and requires Clang C++.")
    return()
  endif()
  if(CMAKE_CUDA_COMPILER_ID AND NOT CMAKE_CUDA_COMPILER_ID MATCHES "Clang")
    set(femx_FOUND FALSE)
    set(femx_NOT_FOUND_MESSAGE
        "This femx package was built with CUDA Enzyme and requires Clang CUDA.")
    return()
  endif()
  find_dependency(Enzyme)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/femxTargets.cmake")

if(TARGET femx::model_navier AND NOT TARGET femx::model::navier)
  add_library(femx::model::navier ALIAS femx::model_navier)
endif()
